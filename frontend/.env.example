# HA-FIM Frontend Environment Variables
# If connecting to an external backend (e.g. deployed on EC2, Render, Fly.io, etc.), set this URL:
# Example: VITE_API_BASE_URL=https://hafim-backend.example.com
# If blank or omitted, API requests will use relative path /api/v1 (ideal for local dev with Vite proxy or same-domain setups)
VITE_API_BASE_URL=
